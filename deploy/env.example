# Do not fill this by hand: scripts/gen_env.sh (called by deploy.sh) creates .env in the repo root
# with random secrets. This file only documents the keys.
ENVIRONMENT=production
POSTGRES_DB=vidora
POSTGRES_USER=vidora
POSTGRES_PASSWORD=<random>
REDIS_PASSWORD=<random>
MINIO_ROOT_USER=vidora-root
MINIO_ROOT_PASSWORD=<random>
S3_ACCESS_KEY=vidora-app
S3_SECRET_KEY=<random>
BUCKET_RAW=vidora-raw
BUCKET_MEDIA=vidora-media
JWT_SECRET=<random>
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@vidora.example.com
ADMIN_PASSWORD=<random>
DEMO_PASSWORD=<random>
MAX_UPLOAD_MB=1024
# Without a domain: internal CA, certificate issued on demand for the IP you open.
# With a domain (deploy.sh --domain d --email e): SITE_ADDRESS=https://d, TLS_KIND=acme, Let's Encrypt.
SITE_ADDRESS=https://
TLS_KIND=internal
ACME_EMAIL=
HSTS_MODE=off
